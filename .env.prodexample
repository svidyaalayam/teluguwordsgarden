# Production configuration template for twords.balamukundam.com
# Copy this to .env on the VM, then replace every <...> placeholder.
# Do not commit the resulting .env file.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generate-a-long-unique-random-secret>
DJANGO_ALLOWED_HOSTS=twords.balamukundam.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://twords.balamukundam.com
# The web app and API are normally served from this same domain.
CORS_ALLOWED_ORIGINS=https://twords.balamukundam.com

POSTGRES_DB=vocabulary
POSTGRES_USER=vocabulary
POSTGRES_PASSWORD=<generate-a-long-unique-database-password>

# Seed once during the initial deployment, then keep this false.
SEED_ON_START=false
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Must match the production JWT configuration used by Balamukundam.
BMK_JWT_SECRET=<production-shared-jwt-secret>
BMK_JWT_ALGORITHM=HS256
# Leave blank when BMK tokens have no audience claim.
BMK_JWT_AUDIENCE=
BMK_API_BASE_URL=https://sri.balamukundam.com

# These values are embedded when the frontend image is built.
VITE_BMK_APP_URL=https://sri.balamukundam.com
VITE_BMK_APP_DOMAIN=balamukundam.com

# Bind the application web port to localhost; the VM's TLS proxy serves it publicly.
WEB_PORT=127.0.0.1:8380
# Do not publish the API directly in production. Remove its ports mapping or bind locally.
API_PORT=127.0.0.1:8300
